# Copie este arquivo para ".env" e preencha com os valores do seu projeto Supabase.
# Nunca commite o arquivo ".env" real — apenas este exemplo.
# Painel: https://supabase.com/dashboard/project/_/settings/api

SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mesmos valores acima, expostos ao frontend (Vite exige o prefixo VITE_).
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Web Push / VAPID (P-256, base64url sem padding).
# Gere um par novo e mantenha a chave privada apenas no ambiente do servidor.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@ticketflow.app
